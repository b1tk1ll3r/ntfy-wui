# Copy to .env and adjust.
# Generate a secret with:  openssl rand -base64 48   (or: ntfywui -gen-secret)
NTFYWUI_SECRET=REPLACE_ME_WITH_BASE64_SECRET

# First WebUI admin – only used while no admin exists yet. Change the password after the first login.
NTFYWUI_BOOTSTRAP_USER=admin
NTFYWUI_BOOTSTRAP_PASS=change-me-now

# Set to false only for plain-HTTP test setups (not localhost).
NTFYWUI_COOKIE_SECURE=true
